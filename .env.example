# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing Firebase Realtime Database (used out of the box)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key

# Supabase (optional: switches server & database storage to Supabase PostgreSQL when configured)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Transactional Emails (server-only)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Sri Ram Events <bookings@yourdomain.com>
BUSINESS_NOTIFICATION_EMAIL=contact@yourdomain.com

# Instagram Graph API (server-only; leave dummy/blank to use safe curated fallback)
INSTAGRAM_ACCESS_TOKEN=dummy_instagram_token
INSTAGRAM_USER_ID=dummy_instagram_user_id

# WhatsApp & Admin Fallback
WHATSAPP_NUMBER=919502559333
ADMIN_PASSCODE=your_admin_passcode
